+	Common::LockGuard lock(m_mutex);

+	int reserved = 0, recording = 0, ready = 0, presenting = 0;

+	for (const auto& r: m_requests) {

+		switch (r.state) {

+			case RequestState::Reserved:   ++reserved; break;

+			case RequestState::Recording:  ++recording; break;

+			case RequestState::Ready:      ++ready; break;

+			case RequestState::Presenting: ++presenting; break;

+		}

+	}

+	return fmt::format("req_total={} (rsv={} rec={} rdy={} prs={}) cpu_pending={}",

