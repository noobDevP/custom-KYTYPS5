+static std::vector<uint64_t> ReadSbtTargetPcs(std::span<const uint32_t> user_data) {
+	std::vector<uint64_t> unique_target_pcs;
+	if (user_data.size() < 14) {
+		return unique_target_pcs;
+	}
+	const uint64_t s12_ptr = (static_cast<uint64_t>(user_data[13]) << 32) | user_data[12];
+	std::array<uint32_t, 4> sbt_desc_words {};
+	if (!ReadShaderGuestMemory(nullptr, s12_ptr + 144, sbt_desc_words)) {
+		return unique_target_pcs;
+	}
+	ShaderBufferResource sbt_desc;
+	std::copy(sbt_desc_words.begin(), sbt_desc_words.end(), sbt_desc.fields);
+	const uint64_t sbt_base = sbt_desc.Base48();
+	const uint32_t sbt_size = sbt_desc.NumRecords();
+	const uint32_t total_records = sbt_size / 16u;
+	for (uint32_t i = 0; i < total_records; ++i) {
+		std::array<uint32_t, 4> record {};
+		if (ReadShaderGuestMemory(nullptr, sbt_base + i * 16u, record)) {
+			const uint64_t target_pc = (static_cast<uint64_t>(record[1]) << 32) | record[0];
+			if (target_pc != 0) {
+				const uint64_t clean_target = target_pc & ~3ull;
+				if (std::ranges::find(unique_target_pcs, clean_target) == unique_target_pcs.end()) {
+					unique_target_pcs.push_back(clean_target);
+				}
+			}
+		}
+	}
+	return unique_target_pcs;
+}
+
+static std::vector<uint64_t> ComputeTargetCodeHashes(const std::vector<uint64_t>& target_pcs) {
+	std::vector<uint64_t> hashes;
+	hashes.reserve(target_pcs.size());
+	for (uint64_t target_pc : target_pcs) {
+		std::vector<uint32_t> callee_words;
+		bool terminated = false;
+		for (uint32_t index = 0;;) {
+			std::array<uint32_t, ShaderRecompiler::Decoder::MaxInstructionRawWords> words {};
+			size_t count = 1;
+			ShaderRecompiler::Decoder::Instruction inst {};
+			bool read_ok = false;
+			for (;;) {
+				if (!ReadShaderGuestMemory(nullptr, target_pc + uint64_t{index} * sizeof(uint32_t),
+				                           std::span(words).first(count))) {
+					break;
+				}
+				inst = {};
+				ShaderRecompiler::Decoder::DecodeInstruction(words, 0, inst);
+				if (inst.word_count <= count) {
+					read_ok = true;
+					break;
+				}
+				count = inst.word_count;
+			}
+			if (!read_ok || inst.opcode == ShaderRecompiler::Decoder::Opcode::UNKNOWN || inst.word_count == 0) {
+				break;
+			}
+			for (size_t w = 0; w < inst.word_count; ++w) {
+				callee_words.push_back(words[w]);
+			}
+			index += inst.word_count;
+			if (inst.opcode == ShaderRecompiler::Decoder::Opcode::S_SETPC_B64 ||
+			    inst.opcode == ShaderRecompiler::Decoder::Opcode::S_ENDPGM) {
+				terminated = true;
+				break;
+			}
+			if (index > 4096) break;
+		}
+		if (terminated && !callee_words.empty()) {
+			hashes.push_back(XXH3_64bits(callee_words.data(), callee_words.size() * sizeof(uint32_t)));
+		} else {
+			hashes.push_back(0);
+		}
+	}
+	return hashes;
+}
