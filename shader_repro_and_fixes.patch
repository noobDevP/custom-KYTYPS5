+static void LogDynamicCallRetentionDiagnostic(uint64_t shader_hash, ShaderType stage,
+                                              bool cache_hit, bool spec_miss,
+                                              const char* link_result, size_t target_count,
+                                              const char* translation_path, uint32_t call_offset) {
+	static std::atomic<uint32_t> s_diag_count {0};
+	const uint32_t count = s_diag_count.fetch_add(1, std::memory_order_relaxed);
+	const bool is_target_shader = (shader_hash == 0x1a04c58a9fbc2052ull);
+	if (count < 64 || is_target_shader) {
+		Log::WriteToConsoleAndLog(fmt::format(
+		    "[DynamicCallDiag #{}] shader=0x{:016x} stage={} cache={} spec_miss={} link={} targets={} trans_path={} call_offset=0x{:04x}\n",
+		    count, shader_hash, ShaderRecompiler::StageName(stage),
+		    cache_hit ? "HIT" : "MISS", spec_miss ? "YES" : "NO",
+		    link_result, target_count, translation_path, call_offset));
+	}
 }
 
